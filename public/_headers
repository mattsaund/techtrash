# Cloudflare headers for static files in public/. worker.js sets its own
# (API, blog media, feed, 404).
# Framing is same-origin only, since the desktop frames its own pages.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Images and fonts cache for a week. Everything else revalidates, so a
# deploy never shows up half done.
/img/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=604800
