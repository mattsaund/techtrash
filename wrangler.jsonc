{
  // must match the Worker's name in the Cloudflare dashboard
  "name": "techtrash",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // only public/ is published
    "directory": "./public",
    // lets worker.js serve public/404.html for unknown paths
    "binding": "ASSETS"
  },
  "d1_databases": [
    // Blog posts, flags, comments and pages, plus the first blog's unused topics.
    // Created on first deploy.
    { "binding": "DB" }
  ],
  "kv_namespaces": [
    // Blog pictures and sounds. Created on first deploy.
    // Don't rename the binding. It's how deploys find the existing namespace.
    { "binding": "PICTURES" }
  ],
  "durable_objects": {
    "bindings": [
      // the shared desktop, server/desktop.js
      { "name": "DESKTOP", "class_name": "Desktop" }
    ]
  },
  "migrations": [
    // Never edit or remove a migration. Only append new ones.
    { "tag": "v1", "new_sqlite_classes": ["Desktop"] }
  ],
  // Workers Logs, in the dashboard's Observability tab
  "observability": { "enabled": true },
  "ratelimits": [
    // admin log on attempts per IP, against password guessing
    { "name": "LOGON_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // blog comments per IP
    { "name": "COMMENT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // shared disk writes per IP (saves, renames, deletes...)
    { "name": "DISK_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ],
  // Admin emails through the domain's Email Routing (server/notify.js). The recipient
  // is the NOTIFY_TO secret and never goes in the repo (README.md, "Deploying").
  "send_email": [
    { "name": "EMAIL" }
  ]
  // Admin credentials are the ADMIN_USERNAME and ADMIN_PASSWORD secrets, not vars
  // (README.md, "Deploying").
}
