{
  // "name" has to match the Worker's name in the Cloudflare dashboard
  "name": "techtrash",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // the public site: everything in public/ and nothing outside it
    "directory": "./public"
  },
  "d1_databases": [
    // the blog's topics and posts; Cloudflare creates it on the first deploy
    { "binding": "DB" }
  ],
  "kv_namespaces": [
    // the blog's topic pictures; Cloudflare creates it on the first deploy
    { "binding": "PICTURES" }
  ],
  "durable_objects": {
    "bindings": [
      // the shared desktop (the Desktop class in server/desktop.js)
      { "name": "DESKTOP", "class_name": "Desktop" }
    ]
  },
  "migrations": [
    // tells Cloudflare to create each object; never edit or remove these, only add new entries at the end
    { "tag": "v1", "new_sqlite_classes": ["Desktop"] }
  ],
  "ratelimits": [
    // 5 admin log on tries a minute per person, so the password can't be guessed
    { "name": "LOGON_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
  // The admin's user name and password are secrets, not settings: ADMIN_USERNAME
  // and ADMIN_PASSWORD. See "The admin" in readme.md.
}
