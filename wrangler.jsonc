{
  // "name" has to match the Worker's name in the Cloudflare dashboard
  "name": "techtrash",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    // the site itself, everything in public/ and nothing outside it
    "directory": "./public",
    // so worker.js can answer an unknown address with public/404.html
    "binding": "ASSETS"
  },
  "d1_databases": [
    // The blog's posts, flags, comments and the site's own words, plus the
    // first blog's topics (kept, but unused). Cloudflare creates it on the
    // first deploy.
    { "binding": "DB" }
  ],
  "kv_namespaces": [
    // The blog's pictures and sounds. Cloudflare creates it on the first
    // deploy. It's still called PICTURES, since that name is how the Worker
    // finds the same store.
    { "binding": "PICTURES" }
  ],
  "durable_objects": {
    "bindings": [
      // the shared desktop (the Desktop class in server/desktop.js)
      { "name": "DESKTOP", "class_name": "Desktop" }
    ]
  },
  "migrations": [
    // These tell Cloudflare to create each object. Never edit or remove one,
    // only add new ones at the end.
    { "tag": "v1", "new_sqlite_classes": ["Desktop"] }
  ],
  // Workers Logs. Whatever the Worker logs, errors included, shows up under
  // its Observability tab in the dashboard.
  "observability": { "enabled": true },
  "ratelimits": [
    // 5 admin log on tries a minute per person, so the password can't be guessed
    { "name": "LOGON_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    // 5 blog comments a minute per person
    { "name": "COMMENT_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    // 60 changes a minute per person to the shared disk (saves, renames, deletes...)
    { "name": "DISK_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  ]
  // The admin's user name and password are secrets, not settings. They're
  // ADMIN_USERNAME and ADMIN_PASSWORD (see "Deploying" in README.md, and
  // server/admin.js).
}
